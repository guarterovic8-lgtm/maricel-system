FLASK_DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://maricel_app:replace-me@127.0.0.1:3306/maricel_pharmacy_db?charset=utf8mb4
SESSION_COOKIE_SECURE=false
# Set to true behind a reverse proxy (Railway, Render, Nginx) so HTTPS and client IPs are detected.
TRUST_PROXY=false
LOW_STOCK_THRESHOLD=10
EXPIRING_WITHIN_DAYS=90
BUSINESS_TIMEZONE=Asia/Manila
# Demo data (flask seed-demo, or SEED_DEMO_DATA=true with start.sh). Passwords must be 12+ characters.
SEED_DEMO_DATA=false
DEMO_OWNER_PASSWORD=
DEMO_CASHIER_PASSWORD=
